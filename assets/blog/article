:root{--navy:#0d1f3c;--navy-mid:#112a50;--orange:#e8642a;--orange-dark:#c4541f;--white:#fff;--gray-100:#f8f9fb;--gray-200:#e9ecef;--gray-600:#6c757d;--text-main:#1a202c;--text-soft:#4a5568;--shadow-md:0 4px 16px rgba(0,0,0,.12);--radius:16px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:var(--gray-100);color:var(--text-main);line-height:1.6}
a{color:inherit;text-decoration:none}
.navbar{position:sticky;top:0;z-index:100;background:rgba(13,31,60,.96);border-bottom:1px solid rgba(255,255,255,.08);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{color:var(--orange);font-family:Georgia,"Times New Roman",serif;font-size:28px;font-weight:700;letter-spacing:3px}
.navbar-links{display:flex;align-items:center;gap:8px}
.navbar-links a{color:rgba(255,255,255,.75);font-size:.85rem;font-weight:600;padding:7px 13px;border-radius:8px}
.navbar-links a:hover{color:var(--white);background:rgba(255,255,255,.08)}
.navbar-links .nav-cta{background:var(--orange);color:var(--white)}
.breadcrumb{max-width:820px;margin:0 auto;padding:16px 24px 0;font-size:.8rem;color:var(--gray-600)}
.breadcrumb a{color:var(--orange)}
.post-hero{background:linear-gradient(135deg,var(--navy),var(--navy-mid));padding:72px 24px 56px;text-align:center}
.post-category{display:inline-block;background:rgba(232,100,42,.15);color:var(--orange);font-size:.68rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;padding:4px 14px;border-radius:100px;margin-bottom:18px}
.post-icon{font-size:3rem;margin-bottom:16px;display:block}
.post-title{font-size:clamp(1.55rem,4vw,2.45rem);font-weight:800;color:var(--white);line-height:1.25;max-width:780px;margin:0 auto 18px}
.post-excerpt{font-size:1rem;color:rgba(255,255,255,.72);max-width:680px;margin:0 auto 24px;line-height:1.7}
.post-meta{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;font-size:.8rem;color:rgba(255,255,255,.55)}
.post-container{max-width:820px;margin:0 auto;padding:48px 24px 80px}
.post-body{background:var(--white);border-radius:var(--radius);padding:48px;box-shadow:var(--shadow-md);font-size:1.03rem;color:var(--text-soft);line-height:1.85}
.post-body p{margin-bottom:18px}
.post-body h2{font-size:1.35rem;font-weight:800;color:var(--text-main);margin:36px 0 14px;padding-top:8px;border-top:2px solid var(--gray-200)}
.post-body h2:first-child{margin-top:0;border-top:none;padding-top:0}
.post-body h3{font-size:1.1rem;font-weight:800;color:var(--text-main);margin:24px 0 10px}
.post-body ul,.post-body ol{margin:0 0 18px 24px}
.post-body li{margin-bottom:8px}
.post-body strong{color:var(--text-main);font-weight:700}
.post-body a{color:var(--orange);text-decoration:underline}
.note{border-left:3px solid var(--orange);padding:14px 18px;background:var(--gray-100);border-radius:0 8px 8px 0;margin:24px 0;color:var(--text-soft)}
.faq-item{margin-bottom:18px;padding:18px;background:var(--gray-100);border-radius:12px}
.faq-q{font-weight:800;color:var(--text-main);margin-bottom:8px}
.cta-box{background:linear-gradient(135deg,var(--navy),var(--navy-mid));border-radius:var(--radius);padding:40px;text-align:center;margin-top:40px}
.cta-box h3{font-size:1.25rem;font-weight:800;color:var(--white);margin-bottom:12px}
.cta-box p{color:rgba(255,255,255,.72);margin-bottom:24px;font-size:.95rem}
.btn-cta{display:inline-flex;align-items:center;gap:8px;background:var(--orange);color:var(--white);padding:13px 28px;border-radius:100px;font-weight:800;font-size:.9rem}
.btn-cta:hover{background:var(--orange-dark)}
.footer{background:var(--navy);color:rgba(255,255,255,.65);text-align:center;padding:28px 24px;font-size:.82rem}
.footer a{color:var(--orange)}
@media(max-width:650px){.post-body{padding:24px 18px}.cta-box{padding:28px 18px}.navbar-links .optional{display:none}}
