{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelierdeconsultanta.ro/schemas/editorial-governance.schema.json",
  "title": "Registru de guvernanță editorială FABER",
  "type": "object",
  "required": ["schemaVersion", "policy", "records"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "policy": {
      "type": "object",
      "required": ["openCallReviewDays", "programReviewDays", "evergreenReviewDays", "humanReviewToken"],
      "properties": {
        "openCallReviewDays": { "const": 30 },
        "programReviewDays": { "type": "integer", "minimum": 30, "maximum": 60 },
        "evergreenReviewDays": { "type": "integer", "minimum": 60, "maximum": 90 },
        "humanReviewToken": { "const": "DE_VALIDAT_UMAN" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dateOrPending": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "const": "DE_VALIDAT_UMAN" }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "route",
        "contentType",
        "programId",
        "governanceState",
        "author",
        "authorRole",
        "reviewer",
        "reviewerRole",
        "attributionType",
        "personalNameConsent",
        "datePublished",
        "verifiedAt",
        "officialSourceUpdatedAt",
        "officialSourceName",
        "officialSourceUrl",
        "sourceVersion",
        "nextReviewAt",
        "lastMeaningfulUpdate",
        "statusSnapshot",
        "changelog"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "route": { "type": "string", "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/?)*$" },
        "contentType": { "enum": ["program", "guide", "tool"] },
        "programId": { "type": ["string", "null"] },
        "governanceState": { "enum": ["public", "pending_validation", "revoked"] },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "reviewer": { "type": "string" },
        "reviewerRole": { "type": "string" },
        "attributionType": { "enum": ["organization", "person"] },
        "personalNameConsent": { "type": "boolean" },
        "datePublished": { "$ref": "#/$defs/dateOrPending" },
        "verifiedAt": { "$ref": "#/$defs/dateOrPending" },
        "officialSourceUpdatedAt": { "$ref": "#/$defs/dateOrPending" },
        "officialSourceName": { "type": "string" },
        "officialSourceUrl": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "nextReviewAt": { "$ref": "#/$defs/dateOrPending" },
        "lastMeaningfulUpdate": { "$ref": "#/$defs/dateOrPending" },
        "statusSnapshot": { "type": ["string", "null"] },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "summary", "reviewer"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "summary": { "type": "string", "minLength": 10 },
              "reviewer": { "type": "string", "minLength": 2 },
              "meaningful": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
