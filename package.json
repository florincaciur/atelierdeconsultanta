{
  "scripts": {
    "optimize:assets": "node scripts/optimize-assets.js",
    "extract:sources": "node tools/extract-source-facts.js",
    "audit:content": "node tools/audit-content-depth.js --min-words 2000",
    "audit:structured-data": "node tools/audit-structured-data.js",
    "audit:gsc-queries": "node tools/import-gsc-query-export.js",
    "normalize:copy": "node tools/normalize-copy-ro.js .",
    "check:copy": "node tools/normalize-copy-ro.js . --check",
    "generate:program-pages": "node tools/generate-program-pages.js",
    "generate:programmatic-seo": "node tools/generate-programmatic-seo.js",
    "apply:design-profiles": "node tools/apply-design-profiles.js",
    "generate:lead-magnets": "node tools/generate-lead-magnets.js",
    "generate:sitemap": "node tools/generate-sitemap.js",
    "generate:feed": "node tools/generate-feed.js",
    "submit:indexnow": "node tools/submit-indexnow.js --changed",
    "submit:indexnow:all": "node tools/submit-indexnow.js --sitemap",
    "verify:sitemap": "node tools/verify-sitemap.js",
    "verify:seo-local": "node tools/validate-seo-local.js",
    "verify:seo": "node scripts/verify-seo-integrity.js .",
    "verify:visual": "node scripts/visual-integrity-check.js",
    "verify:functional": "node verify-and-fix.js",
    "verify:all": "npm run check:copy && npm run generate:sitemap && npm run verify:sitemap && node verify-and-fix.js && node scripts/verify-seo-integrity.js . && node tools/audit-site-links.js",
    "fix:all": "node verify-and-fix.js --apply",
    "build": "npm run apply:design-profiles && npm run generate:sitemap && npm run generate:feed && node tools/build-cloudflare-assets.js",
    "validate:cloudflare": "node tools/validate-cloudflare-deploy.js",
    "audit:program-routes": "node tools/audit-cloudflare-program-routes.js",
    "audit:gsc-routes": "node tools/audit-gsc-routes.js",
    "test:functional": "node tests/faber-functional-checks.mjs",
    "deploy": "npm run build && npm run validate:cloudflare && npx wrangler deploy && npm run submit:indexnow",
    "deploy:pages": "npm run build && npm run validate:cloudflare && npx wrangler pages deploy dist && npm run submit:indexnow",
    "seo:check": "node scripts/seo-release-check.js"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "clean-css": "^5.3.3",
    "exceljs": "^4.4.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "terser": "^5.47.1"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2"
  }
}
