{
  "name": "atelierdeconsultanta",
  "compatibility_date": "2026-05-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run gate:p0:deploy-guard && node tools/build-cloudflare-assets.js && node tools/validate-cloudflare-deploy.js"
  }
}
