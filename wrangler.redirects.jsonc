{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atelierdeconsultanta-domain-seo",
  "main": "cloudflare/domain-seo-redirects.mjs",
  "compatibility_date": "2026-07-20",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "COMPANY_LOOKUP_RATE_LIMITER",
      "namespace_id": "2026090701",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "atelierdeconsultanta.ro/*",
      "zone_name": "atelierdeconsultanta.ro"
    },
    {
      "pattern": "www.atelierdeconsultanta.ro/*",
      "zone_name": "atelierdeconsultanta.ro"
    }
  ]
}
